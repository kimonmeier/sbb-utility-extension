{
	"manifest_version": 3,
	"name": "SBB Utility Extension",
	"version": "1.0.0",
	"description": "A Chrome extension for SBB Utility",
	"side_panel": {
		"default_path": "index.html"
	},
	"host_permissions": ["*://*.sopreweb.sbb.ch/*", "*://sopreweb-tourenplan-api.app.sbb.ch/*"],
	"background": {
		"service_worker": "./assets/background.js",
		"type": "module"
	},
	"cross_origin_embedder_policy": {
		"value": "require-corp"
	},
	"cross_origin_opener_policy": {
		"value": "same-origin"
	},

	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
	},

	"permissions": ["sidePanel", "offscreen", "storage", "tabs", "webRequest"],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
