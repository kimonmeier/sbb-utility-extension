{
  "manifest_version": 3,
  "name": "SBB Utility Extension",
  "version": "1.0.0",
  "description": "A Chrome extension for SBB Utility",
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["sidePanel", "storage", "tabs", "sopreweb.sbb.ch"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}