{
	"compilerOptions": {
		"baseUrl": ".",
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"paths": {
			"@/*": ["src/*"],
			"$lib/*": ["src/lib/*"],
			"$background/*": ["src/background/*"]
		}
	},
	"include": ["vite.config.ts"]
}
